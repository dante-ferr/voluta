{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "control-center-exclusive-zone": true,
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-icon-size": 32,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "notification-window-width": 420,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 10,
  "fit-to-screen": false,
  "control-center-width": 544,
  "control-center-height": 640,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 0,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "label": {
      "max-lines": 1,
      "text": "Notification"
    },
    "mpris": {
      "image-size": 32
    },
    "volume": {
      "label": "\udb81\udd7e"
    },
    "backlight": {
      "label": "\udb80\udcdf"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "\udb81\udc25",
          "command": "bash -c $HOME/.config/hypr/scripts/Wlogout.sh"
        },
        {
          "label": "\udb80\udf3e",
          "command": "bash -c $HOME/.config/hypr/scripts/LockScreen.sh"
        },
        {
          "label": "\udb80\udf43",
          "command": "hyprctl dispatch 'hl.dsp.exit()'"
        },
        {
          "label": "\udb80\udc1d",
          "command": "bash -c $HOME/.config/hypr/scripts/AirplaneMode.sh"
        },
        {
          "label": "\udb81\udf5f",
          "command": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
        },
        {
          "label": "\udb80\udcaf",
          "command": "blueman-manager"
        }
      ]
    }
  },
  "notification-visibility": {
    "cursor": {
      "app-name": "(?i).*cursor.*",
      "state": "enabled",
      "override-urgency": "normal"
    }
  }
}
