{
    "label" : "lock",
    "action" : "$HOME/.config/hypr/scripts/LockScreen.sh",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "python3 $HOME/.config/hypr/scripts/session_manager.py prepare-shutdown; hyprctl dispatch 'hl.dsp.exit()' || uwsm stop || loginctl terminate-session self",
    "text" : "Log Out",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Sleep",
    "keybind" : "u"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "Hibernate",
    "keybind" : "h"
}
{
    "label" : "reboot",
    "action" : "python3 $HOME/.config/hypr/scripts/session_manager.py prepare-shutdown; systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "python3 $HOME/.config/hypr/scripts/session_manager.py prepare-shutdown; systemctl poweroff",
    "text" : "Power Off",
    "keybind" : "s"
}
