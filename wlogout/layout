{
    "label" : "lock",
    "action" : "$HOME/.config/hypr/scripts/LockScreen.sh",
    "text" : "Lock Session",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch exit || uwsm stop || loginctl terminate-session self",
    "text" : "Log Out",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Sleep",
    "keybind" : "u"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "Hibernate",
    "keybind" : "h"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Restart",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Power Off",
    "keybind" : "s"
}
