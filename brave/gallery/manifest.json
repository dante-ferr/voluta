{
  "manifest_version": 3,
  "name": "Voluta Gallery",
  "version": "1.0.0",
  "description": "An architectural New Tab gallery using your local wallpaper and Voluta palette.",
  "permissions": ["storage", "search"],
  "chrome_url_overrides": {"newtab": "index.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'; img-src 'self' data:;"}
}
