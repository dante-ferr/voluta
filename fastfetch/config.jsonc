{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "assets/crown-angels-transparent.png",
    "position": "left",
    "height": 13,
    "padding": {
      "top": 0,
      "left": 0,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 14
    },
    "brightColor": false,
    "color": {
      "keys": "90",
      "output": "white"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "  \u001b[33m❦\u001b[0m  \u001b[1;31mV O L U T A\u001b[0m"
    },
    {
      "type": "title",
      "key": " ",
      "format": "  \u001b[37m{user-name}\u001b[90m@\u001b[37m{host-name}\u001b[0m"
    },
    {
      "type": "custom",
      "format": "  \u001b[90m──────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "  OS",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "host",
      "key": "  Machine",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "  Kernel"
    },
    "break",
    {
      "type": "wm",
      "key": "  Session"
    },
    {
      "type": "shell",
      "key": "  Shell"
    },
    {
      "type": "terminal",
      "key": "  Terminal"
    },
    {
      "type": "uptime",
      "key": "  Uptime"
    },
    {
      "type": "memory",
      "key": "  Memory",
      "format": "{used} / {total}"
    },
    {
      "type": "custom",
      "format": "  \u001b[90m─────────────────────\u001b[33m ❦ \u001b[90m──────────────────────\u001b[0m"
    }
  ]
}
