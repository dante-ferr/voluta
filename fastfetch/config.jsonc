{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "assets/crown-angels-transparent.png",
    "position": "left",
    "height": 13,
    "padding": {
      "top": 0,
      "left": 0,
      "right": 3
    }
  },
  "display": {
    "separator": " ☩ "
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1;33m╔══════════════════════════════════════════════════════╗\u001b[0m"
    },
    {
      "type": "title",
      "key": " 󰀘 User",
      "keyColor": "yellow"
    },
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "yellow"
    },
    {
      "type": "host",
      "key": " 󰍹 Host",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": " 󰒋 Kernel",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": " 󱂬 WM",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": " 󰞷 Shell",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "  Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": " 󰅐 Uptime",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": " 󰍛 Memory",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "\u001b[1;33m╠══════════════════════════════════════════════════════╣\u001b[0m"
    },
    {
      "type": "colors",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "\u001b[1;33m╚══════════════════════════════════════════════════════╝\u001b[0m"
    }
  ]
}
