 /* wallust template - colors-rofi */

* {
active-background: {{color12 | lighten(0.35)}};
active-foreground: {{foreground | lighten(0.30)}};
normal-background: {{background}};
normal-foreground: {{foreground | lighten(0.30)}};
urgent-background: {{color13 | lighten(0.35)}};
urgent-foreground: {{foreground | lighten(0.30)}};

alternate-active-background: {{color11 | lighten(0.35)}};
alternate-active-foreground: {{foreground | lighten(0.30)}};
alternate-normal-background: {{background}};
alternate-normal-foreground: {{foreground | lighten(0.30)}};
alternate-urgent-background: {{background}};
alternate-urgent-foreground: {{foreground | lighten(0.30)}};

selected-active-background: {{color13 | lighten(0.35)}};
selected-active-foreground: {{foreground | lighten(0.30)}};
selected-normal-background: {{color13 | lighten(0.35)}};
selected-normal-foreground: {{foreground | lighten(0.30)}};
selected-urgent-background: {{color12 | lighten(0.35)}};
selected-urgent-foreground: {{foreground | lighten(0.30)}};

background-color: {{background}};
/* Light enough to keep the angel readable, opaque enough for Hyprland layer blur. */
background: rgba({{background | rgb}},0.35);
foreground: {{foreground | lighten(0.30)}};
border-color: {{color12 | lighten(0.35)}};
accent: {{color12 | lighten(0.35)}};

color0: {{color0 | lighten(0.08)}};
color1: {{color1 | lighten(0.30)}};
color2: {{color2 | lighten(0.30)}};
color3: {{color3 | lighten(0.30)}};
color4: {{color4 | lighten(0.30)}};
color5: {{color5 | lighten(0.30)}};
color6: {{color6 | lighten(0.30)}};
color7: {{color7 | lighten(0.30)}};
color8: {{color8 | lighten(0.20)}};
color9: {{color9 | lighten(0.35)}};
color10: {{color10 | lighten(0.35)}};
color11: {{color11 | lighten(0.35)}};
color12: {{color12 | lighten(0.35)}};
color13: {{color13 | lighten(0.35)}};
color14: {{color14 | lighten(0.35)}};
color15: {{color15 | lighten(0.35)}};
}


