/* Shared angel surround and incised tiles.
 * Window size matches the published big-angel-box canvas (1.6× the 720×640 art).
 * Padding equals the clear content hole margins so ornaments stay outside mainbox.
 * A light @background plate gives Hyprland alpha to blur the hollow. The black
 * angel SVG paints on this window. */
window {
    width: 1152px;
    height: 1024px;
    padding: 304px 230px 218px 362px;
    border: 0px;
    border-radius: 0px;
    background-color: @background;
    background-image: url("~/.config/wallust/assets/generated/big-angel-box.svg", both);
}
mainbox {
    padding: 12px 14px 10px;
    spacing: 12px;
    background-color: transparent;
    children: [ "inputbar", "message", "listview" ];
}
inputbar {
    padding: 14px 16px;
    border: 1px 1px 2px;
    border-color: @accent;
    background-color: @bg;
    background-image: none;
}
entry { placeholder-color: @muted; }
listview { spacing: 7px; background-color: transparent; }
element {
    padding: 10px 15px;
    border: 0px;
    border-radius: 0px;
    background-color: transparent;
    /* `both` stretches the chamfered tile; `width` tiles a second strip under each row. */
    background-image: url("~/.config/wallust/assets/generated/tile-frame-list.svg", both);
    text-color: @fg;
}
element selected.normal, element selected.active, element selected.urgent {
    background-color: transparent;
    background-image: url("~/.config/wallust/assets/generated/tile-selected-list.svg", both);
    text-color: @fg;
    border: 0px;
}
element selected.normal element-text, element selected.active element-text {
    text-color: @fg;
}
element-icon { size: 24px; }
message { padding: 2px 0px; border: 0px; background-color: transparent; }
textbox { text-color: @muted; background-color: transparent; }
