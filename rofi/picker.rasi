/* Imperium character picker (rofimoji) — emoji Super+. / symbols Super+, */

@import "wallust/colors-rofi.rasi"

* {
    accent: @active-background;
    bg: @normal-background;
    fg: @normal-foreground;
    muted: @color8;
    card-bg: @color0;
    border-subtle: @color0;
    engraved: @normal-background;

    border-radius: 0px;
    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 720px;

    enabled: true;
    margin: 0px;
    padding: 0px;
    border: 2px solid;
    border-color: @accent;
    border-radius: 0px;
    background-color: @bg;
}

mainbox {
    enabled: true;
    orientation: vertical;
    spacing: 14px;
    margin: 0px;
    padding: 20px;
    border: 0px;
    background-color: @bg;
    children: [ "inputbar", "message", "listview" ];
}

inputbar {
    enabled: true;
    spacing: 12px;
    margin: 0px;
    padding: 12px 16px;
    border: 1px solid;
    border-color: @accent;
    border-radius: 0px;
    background-color: @card-bg;
    text-color: @fg;
    children: [ "prompt", "entry" ];
}

prompt {
    enabled: true;
    background-color: inherit;
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    enabled: true;
    background-color: inherit;
    text-color: inherit;
    cursor: text;
    placeholder: "Search characters...";
    placeholder-color: @muted;
    font: "JetBrainsMono Nerd Font 11";
}

message {
    enabled: true;
    margin: 0px;
    padding: 8px 12px;
    border: 1px solid;
    border-color: @border-subtle;
    border-radius: 0px;
    background-color: @card-bg;
    text-color: @muted;
}

textbox {
    background-color: inherit;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font 10";
}

listview {
    enabled: true;
    columns: 2;
    lines: 8;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;

    spacing: 8px;
    margin: 0px;
    padding: 0px;
    border: 0px;
    background-color: transparent;
    text-color: @fg;
}

element {
    enabled: true;
    orientation: horizontal;
    spacing: 12px;
    margin: 0px;
    padding: 10px 14px;
    border: 1px solid;
    border-color: @border-subtle;
    border-radius: 0px;
    background-color: @card-bg;
    text-color: @fg;
    cursor: pointer;
}

element selected.normal {
    background-color: @accent;
    border-color: @accent;
    text-color: @engraved;
}

element selected.normal element-text {
    text-color: @engraved;
    font-weight: 800;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
    font: "JetBrainsMono Nerd Font 12";
}

@import "frame.rasi"
element { background-image: url("~/.config/wallust/assets/generated/tile-frame.svg", both); }
element selected.normal, element selected.active, element selected.urgent {
    background-image: url("~/.config/wallust/assets/generated/tile-selected.svg", both);
}
