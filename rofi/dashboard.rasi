/* Imperium App Browser (Rofi) - Perfectly Balanced, solid, fully wallust-driven */

configuration {
    modi: "drun,run,filebrowser";
    show-icons: true;
    display-drun: "Apps";
    display-run: "Run";
    display-filebrowser: "Files";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 11";
}

@import "wallust/colors-rofi.rasi"

* {
    accent: @active-background;
    bg: @normal-background;
    fg: @normal-foreground;
    muted: @color8;
    card-bg: @color0;
    border-subtle: @color0;
    engraved: @normal-background;

    border-radius: 0px;
    background-color: transparent;
    text-color: @fg;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    /* The block after @import frame.rasi turns this window fullscreen and
       centers the angel plate. Stay transparent here so an earlier opaque
       plate cannot win if import order changes. */
    enabled: true;
    margin: 0px;
    padding: 0px;
    border: 0px;
    border-radius: 0px;
    background-color: transparent;
}

mainbox {
    enabled: true;
    orientation: vertical;
    spacing: 14px;
    margin: 0px;
    padding: 0px;
    border: 0px;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

/* ====================================================
   TOP: SEARCH INPUT BAR
   ==================================================== */

inputbar {
    enabled: true;
    spacing: 12px;
    margin: 0px;
    padding: 12px 16px;
    border: 1px solid;
    border-color: @accent;
    border-radius: 0px;
    background-color: @card-bg;
    text-color: @fg;
    children: [ "prompt", "entry" ];
}

prompt {
    enabled: true;
    background-color: inherit;
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    enabled: true;
    background-color: inherit;
    text-color: inherit;
    cursor: text;
    placeholder: "Search applications or commands...";
    placeholder-color: @muted;
    font: "JetBrainsMono Nerd Font 11";
}

/* ====================================================
   APP BROWSER GRID (BALANCED 2-COLUMN TILES)
   ==================================================== */

listview {
    enabled: true;
    columns: 2;
    lines: 7;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    
    spacing: 8px;
    margin: 0px;
    padding: 0px;
    border: 0px;
    background-color: transparent;
    text-color: @fg;
}

element {
    enabled: true;
    orientation: horizontal;
    spacing: 12px;
    margin: 0px;
    padding: 10px 14px;
    border: 1px solid;
    border-color: @border-subtle;
    border-radius: 0px;
    background-color: @bg;
    text-color: @fg;
    cursor: pointer;
}

element selected.normal {
    background-color: @accent;
    border-color: @accent;
    text-color: @engraved;
}

element selected.normal element-text {
    text-color: @engraved;
    font-weight: 800;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 28px;
    cursor: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
    font: "JetBrainsMono Nerd Font 11";
}

@import "frame.rasi"
/* Later rules win. Rofi fits a background image inside the widget and
   repeats whatever is left over, so the angel must be exactly 1152×1024.
   Window padding centers that plate. The hollow padding is on mainbox;
   the image still paints the full plate, including that padding. */
window {
    fullscreen: true;
    width: 100%;
    height: 100%;
    /* Center the 1152×1024 plate on the monitor Rofi actually uses.
       A launcher script that guesses this from hyprctl can miss and pin
       the plate to the top-left. */
    padding: calc(50% - 512px) calc(50% - 576px) calc(50% - 512px) calc(50% - 576px);
    background-color: transparent;
    background-image: url("~/.config/wallust/assets/generated/launcher-vignette.svg", both);
}
mainbox {
    width: 1152px;
    height: 1024px;
    /* Fill the padded slot. A fixed height is ignored on a box, and a
       shorter plate scales the angel and shifts the menu in the hollow. */
    expand: true;
    margin: 0px;
    padding: 316px 210px 233px 310px;
    background-color: transparent;
    background-image: url("~/.config/wallust/assets/generated/big-angel-box.svg", both);
}
inputbar { margin: 0px; }
listview { margin: 0px; }
element {
    border: 1px;
    border-color: @border-subtle;
    background-color: @bg;
    background-image: none;
    text-color: @fg;
}
element selected.normal, element selected.active, element selected.urgent {
    border: 1px;
    border-color: @accent;
    background-color: @accent;
    background-image: none;
    text-color: @engraved;
}
element selected.normal element-text,
element selected.active element-text,
element selected.urgent element-text {
    text-color: @engraved;
}
