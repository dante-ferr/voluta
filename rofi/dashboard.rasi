/* Imperium App Browser (Rofi) - Perfectly Balanced, solid, fully wallust-driven */

configuration {
    modi: "drun,run,filebrowser";
    show-icons: true;
    display-drun: " 󰀘 Apps";
    display-run: " ⚙ Run";
    display-filebrowser: " 📁 Files";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 11";
}

@import "wallust/colors-rofi.rasi"

* {
    accent: @active-background;
    bg: @normal-background;
    fg: @normal-foreground;
    muted: @color8;
    card-bg: @color0;
    border-subtle: @color0;
    engraved: @normal-background;

    border-radius: 0px;
    background-color: transparent;
    text-color: @fg;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 720px;

    enabled: true;
    margin: 0px;
    padding: 0px;
    border: 2px solid;
    border-color: @accent;
    border-radius: 0px; /* Strict 0px sharp corners */
    background-color: @bg; /* 100% Opaque Obsidian */
}

mainbox {
    enabled: true;
    orientation: vertical;
    spacing: 14px;
    margin: 0px;
    padding: 20px;
    border: 0px;
    background-color: @bg;
    children: [ "inputbar", "listview" ];
}

/* ====================================================
   TOP: SEARCH INPUT BAR
   ==================================================== */

inputbar {
    enabled: true;
    spacing: 12px;
    margin: 0px;
    padding: 12px 16px;
    border: 1px solid;
    border-color: @accent;
    border-radius: 0px;
    background-color: @card-bg;
    text-color: @fg;
    children: [ "prompt", "entry" ];
}

prompt {
    enabled: true;
    background-color: inherit;
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    enabled: true;
    background-color: inherit;
    text-color: inherit;
    cursor: text;
    placeholder: "Search applications or commands...";
    placeholder-color: @muted;
    font: "JetBrainsMono Nerd Font 11";
}

/* ====================================================
   APP BROWSER GRID (BALANCED 2-COLUMN TILES)
   ==================================================== */

listview {
    enabled: true;
    columns: 2;
    lines: 7;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;
    
    spacing: 8px;
    margin: 0px;
    padding: 0px;
    border: 0px;
    background-color: transparent;
    text-color: @fg;
}

element {
    enabled: true;
    orientation: horizontal;
    spacing: 12px;
    margin: 0px;
    padding: 10px 14px;
    border: 1px solid;
    border-color: @border-subtle;
    border-radius: 0px;
    background-color: @card-bg;
    text-color: @fg;
    cursor: pointer;
}

element selected.normal {
    background-color: @accent;
    border-color: @accent;
    text-color: @engraved; /* Crisp dark engraved text on active tile */
}

element selected.normal element-text {
    text-color: @engraved;
    font-weight: 800;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 28px;
    cursor: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
    font: "JetBrainsMono Nerd Font 11";
}
