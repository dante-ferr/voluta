/* RGB gallery: inherit every paint from the active Wallust Rofi theme. */
@import "config.rasi"

window {
    width: 1150px;
    height: 760px;
    background-image: url("~/.config/wallust/assets/generated/panel-frame-wide.svg", both);
}

mainbox {
    children: [ "voluta-crown", "inputbar", "message", "listview", "voluta-foot" ];
}

listview {
    lines: 10;
    scrollbar: true;
}

message {
    background-color: transparent;
    text-color: @muted;
    padding: 0px 0px 8px;
}

textbox {
    background-color: transparent;
    text-color: @muted;
}
element { background-image: url("~/.config/wallust/assets/generated/tile-frame-wide.svg", width); }
element selected.normal, element selected.active, element selected.urgent {
    background-image: url("~/.config/wallust/assets/generated/tile-selected-wide.svg", width);
}
