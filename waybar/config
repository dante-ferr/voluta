{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 34,
    "modules-left": [
        "hyprland/window",
        "mpris"
    ],
    "modules-center": [
        "custom/cherub-outer-left",
        "custom/cherub-left",
        "custom/angel-left",
        "hyprland/workspaces",
        "clock",
        "custom/angel-right",
        "custom/cherub-right",
        "custom/cherub-outer-right"
    ],
    "modules-right": [
        "custom/swaync",
        "tray",
        "temperature",
        "network",
        "pulseaudio",
        "custom/patera",
        "battery",
        "custom/power"
    ],
    "hyprland/window": {
        "format": "{title}",
        "max-length": 32,
        "separate-outputs": false,
        "rewrite": {
            "^$": ""
        }
    },
    "mpris": {
        "format": "{title}",
        "format-paused": "<i>{title}</i>",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "max-length": 25,
        "tooltip": true
    },
    "custom/angel-left": {
        "exec": "$HOME/.config/waybar/scripts/angel-flare.py",
        "return-type": "json",
        "restart-interval": 5,
        "tooltip": false
    },
    "custom/angel-right": {
        "exec": "$HOME/.config/waybar/scripts/angel-flare.py",
        "return-type": "json",
        "restart-interval": 5,
        "tooltip": false
    },
    "custom/cherub-left": {
        "exec": "$HOME/.config/waybar/scripts/angel-flare.py",
        "return-type": "json",
        "restart-interval": 5,
        "tooltip": false
    },
    "custom/cherub-right": {
        "exec": "$HOME/.config/waybar/scripts/angel-flare.py",
        "return-type": "json",
        "restart-interval": 5,
        "tooltip": false
    },
    "custom/cherub-outer-left": {
        "exec": "$HOME/.config/waybar/scripts/angel-flare.py",
        "return-type": "json",
        "restart-interval": 5,
        "tooltip": false
    },
    "custom/cherub-outer-right": {
        "exec": "$HOME/.config/waybar/scripts/angel-flare.py",
        "return-type": "json",
        "restart-interval": 5,
        "tooltip": false
    },
    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "disable-scroll": false,
        "format": "{icon} {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "",
        "window-rewrite": {
            "title<.*youtube.*>": "󰗃",
            "title<.*github.*>": "󰊤",
            "class<kitty>": "",
            "class<alacritty>": "",
            "class<foot>": "",
            "class<wezterm>": "",
            "class<brave-browser>": "󰖟",
            "class<firefox>": "",
            "class<floorp>": "󰈹",
            "class<chromium>": "",
            "class<google-chrome>": "",
            "class<zen-alpha>": "󰈹",
            "class<[Cc]ursor>": "󰅩",
            "class<[Cc]ode>": "󰨞",
            "class<vscodium>": "󰨞",
            "class<neovim>": "",
            "class<nvim>": "",
            "class<mousepad>": "󰎞",
            "class<.*obsidian.*>": "󱓧",
            "class<libreoffice-writer>": "󰈙",
            "class<libreoffice-calc>": "󰈛",
            "class<libreoffice-impress>": "󰈧",
            "class<libreoffice.*>": "󰈙",
            "class<.*[Gg]odot.*>": "",
            "class<.*[Bb]lockbench.*>": "󰆧",
            "class<.*[Aa]rduino.*>": "",
            "class<discord>": "󰙯",
            "class<vesktop>": "󰙯",
            "class<webcord>": "󰙯",
            "class<telegram.*>": "",
            "class<spotify>": "",
            "class<mpv>": "󰕼",
            "class<vlc>": "󰕼",
            "class<.*pavucontrol.*>": "󰕾",
            "class<org.pulseaudio.pavucontrol>": "󰕾",
            "class<steam>": "󰓓",
            "class<.*nautilus.*>": "󰉋",
            "class<thunar>": "󰉋",
            "class<waypaper>": "󰸉",
            "class<system-monitor>": "󰍛",
            "class<gnome-system-monitor.*>": "󰍛",
            "class<btop>": "󰍛",
            "class<htop>": "󰍛",
            "class<qalculate.*>": "󰪚",
            "class<gparted>": "󱂵",
            "class<proton.*>": "󰒄"
        },
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "10": "X",
            "default": "·"
        },
        "tooltip": false
    },
    "clock": {
        "format": "󰅐  {:%H:%M:%S  ·  %a, %b %d}",
        "interval": 1,
        "tooltip": false
    },
    "custom/swaync": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚<sup></sup>",
            "none": "󰂚",
            "dnd-notification": "󰂛<sup></sup>",
            "dnd-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "tray": {
        "icon-size": 13,
        "spacing": 8
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{icon}",
        "format-icons": ["󰔏", "󱃂", "󰔐"],
        "tooltip": true,
        "tooltip-format": "{temperatureC}°C"
    },
    "network": {
        "format": "{ifname}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰌘",
        "format-disconnected": "󰌙",
        "tooltip-format": "{ipaddr}  {bandwidthUpBits}  {bandwidthDownBits}",
        "format-linked": "󰈁 {ifname} (No IP)",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) {icon}",
        "tooltip-format-ethernet": "{ifname} 󰌘",
        "tooltip-format-disconnected": "󰌙 Disconnected",
        "max-length": 30,
        "format-icons": [
            "󰤯", "󰤟", "󰤢", "󰤥", "󰤨"
        ],
        "on-click": "$HOME/.config/hypr/scripts/RofiWifi.sh",
        "on-click-right": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol-qt || pavucontrol",
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": true,
        "tooltip-format": "{timeTo}"
    },
    "custom/patera": {
        "format": " ",
        "tooltip": false
    },
    "custom/power": {
        "format": "󰐥",
        "on-click": "~/.config/hypr/scripts/Wlogout.sh",
        "tooltip": false
    }
}
