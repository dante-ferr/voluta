{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 34,
    "margin-top": 4,
    "margin-left": 16,
    "margin-right": 16,
    "modules-left": [
        "hyprland/window",
        "custom/mpris"
    ],
    "modules-center": [
        "custom/angel-left",
        "hyprland/workspaces",
        "group/timedate",
        "custom/angel-right"
    ],
    "modules-right": [
        "custom/swaync",
        "tray",
        "temperature",
        "network",
        "bluetooth",
        "pulseaudio",
        "custom/patera",
        "group/powerplate"
    ],
    "group/powerplate": {
        "orientation": "horizontal",
        "modules": [
            "battery",
            "custom/power"
        ]
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 48,
        "separate-outputs": false,
        "rewrite": {
            "^$": "󰋜  voluta"
        }
    },
    "custom/mpris": {
        "exec": "$HOME/.config/waybar/scripts/mpris-status.sh",
        "interval": 1,
        "return-type": "json",
        "format": "{}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "max-length": 25,
        "tooltip": true
    },
    "custom/angel-left": {
        "format": " ",
        "tooltip": false
    },
    "custom/angel-right": {
        "format": " ",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "disable-scroll": false,
        "format": "{icon} {windows}",
        "format-window-separator": "  ",
        "window-rewrite-default": "",
        "window-rewrite": {
            "title<.*youtube.*>": "󰗃",
            "title<.*github.*>": "󰊤",
            "class<kitty>": "",
            "class<alacritty>": "",
            "class<foot>": "",
            "class<wezterm>": "",
            "class<brave-browser>": "󰖟",
            "class<firefox>": "",
            "class<floorp>": "󰈹",
            "class<chromium>": "",
            "class<google-chrome>": "",
            "class<zen-alpha>": "󰈹",
            "class<[Cc]ursor>": "󰅩",
            "class<[Cc]ode>": "󰨞",
            "class<vscodium>": "󰨞",
            "class<neovim>": "",
            "class<nvim>": "",
            "class<mousepad>": "󰎞",
            "class<.*obsidian.*>": "󱓧",
            "class<libreoffice-writer>": "󰈙",
            "class<libreoffice-calc>": "󰈛",
            "class<libreoffice-impress>": "󰈧",
            "class<libreoffice.*>": "󰈙",
            "class<.*[Gg]odot.*>": "",
            "class<.*[Bb]lockbench.*>": "󰆧",
            "class<.*[Aa]rduino.*>": "",
            "class<discord>": "󰙯",
            "class<vesktop>": "󰙯",
            "class<webcord>": "󰙯",
            "class<telegram.*>": "",
            "class<spotify>": "",
            "class<mpv>": "󰕼",
            "class<vlc>": "󰕼",
            "class<.*pavucontrol.*>": "󰕾",
            "class<org.pulseaudio.pavucontrol>": "󰕾",
            "class<steam>": "󰓓",
            "class<.*dolphin.*>": "󰉋",
            "class<.*nautilus.*>": "󰉋",
            "class<thunar>": "󰉋",
            "class<waypaper>": "󰸉",
            "class<system-monitor>": "󰍛",
            "class<gnome-system-monitor.*>": "󰍛",
            "class<btop>": "󰍛",
            "class<htop>": "󰍛",
            "class<qalculate.*>": "󰪚",
            "class<gparted>": "󱂵",
            "class<proton.*>": "󰒄"
        },
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "10": "X",
            "default": "·"
        },
        "tooltip": false
    },
    "group/timedate": {
        "orientation": "horizontal",
        "modules": [
            "clock#time",
            "clock#date"
        ]
    },
    "clock#time": {
        "format": "󰅐  {:%H:%M:%S}",
        "interval": 1,
        "tooltip": false
    },
    "clock#date": {
        "format": "{:%a, %b %d}",
        "interval": 60,
        "tooltip": false
    },
    "custom/swaync": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚<sup></sup>",
            "none": "󰂚",
            "dnd-notification": "󰂛<sup></sup>",
            "dnd-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "sh \"$HOME/.config/swaync/toggle-panel.sh\"",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "tray": {
        "icon-size": 13,
        "spacing": 8
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{icon}",
        "format-icons": ["󰔏", "󱃂", "󰔐"],
        "tooltip": true,
        "tooltip-format": "{temperatureC}°C"
    },
    "network": {
        "format": "{ifname}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰌘",
        "format-disconnected": "󰌙",
        "tooltip-format": "{ipaddr}  {bandwidthUpBits}  {bandwidthDownBits}",
        "format-linked": "󰈁 {ifname} (No IP)",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) {icon}",
        "tooltip-format-ethernet": "{ifname} 󰌘",
        "tooltip-format-disconnected": "󰌙 Disconnected",
        "max-length": 30,
        "format-icons": [
            "󰤯", "󰤟", "󰤢", "󰤥", "󰤨"
        ],
        "on-click": "$HOME/.config/hypr/scripts/RofiWifi.sh",
        "on-click-right": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-no-controller": "",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol-qt || pavucontrol",
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": true,
        "tooltip-format": "{timeTo}"
    },
    "custom/patera": {
        "format": " ",
        "tooltip": false
    },
    "custom/power": {
        "format": "󰐥",
        "on-click": "~/.config/hypr/scripts/Wlogout.sh",
        "tooltip": false
    }
}
